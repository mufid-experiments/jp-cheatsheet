#!/usr/bin/env ruby
# frozen_string_literal: true

# Builds the cheatsheets from Jekyll-flavoured Markdown into HTML and PDF.
#
#   bin/build                 # every topic -> build/<topic>.html + build/<topic>.pdf
#   bin/build sentence        # only topics/sentence.md
#   bin/build --html          # HTML only, skip the PDF
#
# A full build (no topic given) also writes build/index.html, the landing page
# of the site published to GitHub Pages (see .github/workflows/pages.yml).
#
# Topics: every page with `layout: cheatsheet` (all of topics/*.md, see the
# `defaults` in _config.yml), so topics/sentence.md -> build/sentence.pdf.
#
# HTML is rendered by Jekyll (kramdown + the `cheatsheet` layout, CSS inlined).
# Furigana is plain HTML in the Markdown: <ruby>食<rt>た</rt></ruby>べる.
# The PDF is printed from that HTML by headless Chrome (override with CHROME=/path).

require "cgi"
require "fileutils"
require "jekyll"

ROOT = File.expand_path("..", __dir__)
OUT  = File.join(ROOT, "build")

CHROME_CANDIDATES = [
  ENV["CHROME"],
  "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
  "/Applications/Brave Browser.app/Contents/MacOS/Brave Browser",
  "/Applications/Chromium.app/Contents/MacOS/Chromium",
  "google-chrome", "chromium", "chromium-browser"
].compact

def chrome
  @chrome ||= CHROME_CANDIDATES.find do |c|
    c.include?("/") ? File.executable?(c) : system("command -v #{c} >/dev/null 2>&1")
  end || abort("Chrome not found; set CHROME=/path/to/chrome")
end

def build_site
  config = Jekyll.configuration(
    "source" => ROOT,
    "destination" => File.join(ROOT, "_site"),
    "quiet" => true
  )
  site = Jekyll::Site.new(config)
  site.process
  site
end

def print_pdf(html_path, pdf_path)
  ok = system(
    chrome,
    "--headless=new", "--disable-gpu", "--no-pdf-header-footer",
    "--virtual-time-budget=5000",
    "--print-to-pdf=#{pdf_path}",
    "file://#{html_path}",
    out: File::NULL, err: File::NULL
  )
  abort("PDF generation failed for #{html_path}") unless ok && File.exist?(pdf_path)
end

html_only = ARGV.include?("--html")
wanted    = ARGV.reject { |a| a.start_with?("--") }.map { |a| File.basename(a, ".*") }
FileUtils.mkdir_p(OUT)

site  = build_site
pages = site.pages.select { |p| p.data["layout"] == "cheatsheet" }
pages = pages.select { |p| wanted.include?(File.basename(p.name, ".*")) } unless wanted.empty?
abort("No matching topics found") if pages.empty?

def write_index(pages, html_only)
  items = pages.sort_by(&:name).map do |page|
    name = File.basename(page.name, ".*")
    pdf  = html_only ? "" : %( · <a href="#{name}.pdf">PDF</a>)
    <<~ITEM
      <li><a href="#{name}.html">#{CGI.escapeHTML(page.data["title"])}</a>#{pdf}
        <span>#{page.data["title_ja"]}</span></li>
    ITEM
  end

  path = File.join(OUT, "index.html")
  File.write(path, <<~HTML)
    <!doctype html>
    <html lang="en">
    <head>
      <meta charset="utf-8">
      <meta name="viewport" content="width=device-width, initial-scale=1">
      <title>ムフィドの日本語学習早見表</title>
      <style>
        body { font-family: system-ui, "Hiragino Sans", sans-serif; max-width: 40rem; margin: 2rem auto; padding: 0 1rem; line-height: 1.6; }
        li { margin-bottom: .75rem; }
        li span { display: block; color: #666; }
      </style>
    </head>
    <body>
      <h1>ムフィドの日本語学習早見表</h1>
      <ul>
    #{items.join.gsub(/^/, "    ")}  </ul>
    </body>
    </html>
  HTML
  puts "INDEX #{path}"
end

pages.each do |page|
  name = File.basename(page.name, ".*")

  html = File.join(OUT, "#{name}.html")
  FileUtils.cp(page.destination(site.dest), html)
  puts "HTML  #{html}"

  next if html_only

  pdf = File.join(OUT, "#{name}.pdf")
  print_pdf(html, pdf)
  puts "PDF   #{pdf}"
end

# The landing page for the published site; only for a full build.
write_index(pages, html_only) if wanted.empty?
